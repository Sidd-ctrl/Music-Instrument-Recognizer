{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3.9.18"
    }
  },
  "rewrites": [
    { "source": "/api/python/:path*", "destination": "/api/index.py" }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": ""
  }
}
